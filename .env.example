APP_NAME=skeleton
APP_ENV=dev
APP_DEBUG=true

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_SECRET_PC=your-pc-secret-key
JWT_SECRET_WEAPP=your-weapp-secret-key

# Signature Configuration
SIGN_KEY=your-sign-key-change-in-production
SIGN_TIMESTAMP_DRIFT=300
IS_CHECK_SIGN=true

# Translation Configuration
DEFAULT_LANG=zh-cn

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OSS Configuration
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ENDPOINT=
BUCKET=
BASE_URL=
